{
	"name": "coverfetch-api",
	"module": "src/app.ts",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --hot src/app.ts",
		"test": "bun --env-file=.env.test test",
		"test:watch": "bun --env-file=.env.test test --watch",
		"start": "bun src/app.ts",
		"hardcover-typegen": "bun run src/generate-hardcover-spec.ts",
		"db-typegen": "bun run kysely-codegen",
		"db-migrate-latest": "bun --bun run kysely migrate:latest",
		"db-migrate-up": "bun --bun kysely migrate:up",
		"db-migrate-down": "bun --bun kysely migrate:down",
		"db-migrate-list": "bun --bun kysely migrate:list",
		"db-create-migration": "bun --bun kysely migrate:make",
		"db-seed-create": "bun --bun kysely seed:make",
		"db-seed-run": "bun --bun kysely seed:run",
        "test-db:start": "docker compose -f ./docker-compose.yml up -d --wait && echo '✅ Test database is ready' && bun --env-file=.env.test --bun kysely migrate:latest",
        "test-db:stop": "docker compose -f ./docker-compose.yml down --volumes"
	},
	"kysely-codegen": {
		"dialect": "postgres",
		"camelCase": true,
		"envFile": ".env",
		"outFile": "./src/db/types.ts",
		"runtimeEnums": false,
		"typeOnlyImports": true
	},
	"devDependencies": {
		"@mswjs/interceptors": "^0.45.11",
		"@rcmade/hono-docs": "^1.4.1",
		"@types/bun": "1.4.4",
		"@types/pg": "^8.23.1",
		"kysely-codegen": "^0.20.0",
		"kysely-ctl": "^0.22.0",
		"msw": "^3.0.4"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.110",
		"@better-auth/api-key": "^1.7.18",
		"@flipt-io/flipt-client-js": "^0.6.0",
		"@genql/cli": "^6.3.4",
		"@hono/zod-openapi": "^1.6.3",
		"ai": "^7.0.164",
		"better-auth": "^1.7.18",
		"hono": "^4.13.16",
		"ky": "^2.2.0",
		"kysely": "^0.29.8",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	}
}
